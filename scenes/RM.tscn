[sub_resource type="GDScript" id="GDScript_ot3ca"]
script/source = "extends Node3D

# ================= 节点精准获取 =================
# 基地
@onready var blue_base = $world/blue_base
@onready var red_base = $world/red_base

# 前哨站 (包在 outpost 下面的 Target2)
@onready var blue_outpost = $world/blue_outpost
@onready var red_outpost = $world/red_outpost

# 能量机关 (假设放在 rune 节点下)
@onready var energy_mechanism = $world/rune/Target1
# 玩家
@onready var player = $Infantry

# ================= 初始化 =================
func _ready() -> void:
	if player and player.has_method(\"update_health_ui\"):
		player.health_changed.connect($HUD.update_health_ui)
	
	# 1. 连接基地死亡信号 (判断胜负)
	if blue_base: 
		blue_base.base_destroyed.connect(_on_base_destroyed)
	if red_base: 
		red_base.base_destroyed.connect(_on_base_destroyed)
		
	# 2. 连接前哨站死亡信号 (蓝方)
	if blue_outpost:
		if blue_outpost.has_signal(\"sentry_destroyed\"):
			blue_outpost.sentry_destroyed.connect(_on_blue_sentry_destroyed)
			print(\"✅ 蓝方前哨站信号连接成功！\")
		else:
			print(\"❌ 蓝方前哨站没有 sentry_destroyed 信号！\")
	else:
		print(\"❌ 找不到蓝方前哨站路径！\")
		
	# 3. 连接前哨站死亡信号 (红方)
	if red_outpost:
		if red_outpost.has_signal(\"sentry_destroyed\"):
			red_outpost.sentry_destroyed.connect(_on_red_sentry_destroyed)
			print(\"✅ 红方前哨站信号连接成功！\")
		else:
			print(\"❌ 红方前哨站没有 sentry_destroyed 信号！\")
	else:
		print(\"❌ 找不到红方前哨站路径！\")
		
	# 4. 连接能量机关结束信号 (放在这里统一连接一次即可)
	if energy_mechanism:
		if not energy_mechanism.energy_finished.is_connected(_on_energy_finished):
			energy_mechanism.energy_finished.connect(_on_energy_finished)
			
	# 将步兵的血量变化，连接到 HUD 的更新函数
	var hud = get_tree().current_scene.get_node_or_null(\"HUD\")
	var infantry = get_tree().current_scene.get_node_or_null(\"Infantry\")
	
	if hud and infantry:
		# 检查步兵有没有这个信号，HUD有没有这个函数
		if infantry.has_signal(\"health_changed\") and hud.has_method(\"update_health_ui\"):
			# 先断开旧的（防止重复报错），再重新连上
			if infantry.health_changed.is_connected(hud.update_health_ui):
				infantry.health_changed.disconnect(hud.update_health_ui)
				
			infantry.health_changed.connect(hud.update_health_ui)
			print(\"✅ 血条信号连接成功！\")

# ================= 前哨站被毁 -> 激活基地靶子 =================

func _on_blue_sentry_destroyed() -> void:
	print(\"💥 蓝方前哨站已毁！正在激活蓝方基地靶子...\")
	if blue_base and blue_base.has_method(\"activate_target\"):
		blue_base.activate_target()
	# 给玩家加 150 点经验
	if player and player.has_method(\"add_xp\"):
		player.add_xp(150)

func _on_red_sentry_destroyed() -> void:
	print(\"💥 红方前哨站已毁！正在激活红方基地靶子...\")
	if red_base and red_base.has_method(\"activate_target\"):
		red_base.activate_target()
	# 给玩家加 150 点经验
	if player and player.has_method(\"add_xp\"):
		player.add_xp(150)

# ================= 基地被毁 -> 游戏结算 =================
func _on_base_destroyed(base_name: String) -> void:
	# 假设你是红方视角，如果蓝方基地炸了，你胜利
	if \"blue\" in base_name:
		$HUD.show_game_over(true, \"红方基地被摧毁\")
	else:
		$HUD.show_game_over(false, \"蓝方基地被摧毁\")

# ================= 按键控制能量机关 =================
func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed:
		# 按 1 开启：一轮亮 1 个
		if event.keycode == KEY_1:
			if energy_mechanism:
				energy_mechanism.start_energy_mechanism(1)
				
		# 按 2 开启：一轮亮 2 个
		if event.keycode == KEY_2:
			if energy_mechanism:
				energy_mechanism.start_energy_mechanism(2)

# ================= 能量机关打完后发放奖励 =================
func _on_energy_finished() -> void:
	print(\"🎁 机关结束，发放攻击加成！\")
	if player and player.has_method(\"receive_buff\"):
		# 调用最新设计的接口：类型，持续时间，幅度
		# 发 10 秒攻击加成，幅度 0.5 (伤害增加 50%)
		player.receive_buff(\"attack\", 10.0, 0.5)
"

[sub_resource type="GDScript" id="GDScript_8kgq7"]
script/source = "extends Node3D

signal base_destroyed(base_name: String)

@export var max_health: int = 4500
var current_health: int
var is_dead: bool = false

# --- 血条配置 ---
@export var bar_width: float = 6.0
@export var bar_height: float = 0.6
@export var bar_offset: Vector3 = Vector3(0, 0, 2) # 血条高度，你可以根据基地模型自己调

var hp_bar_fill: MeshInstance3D
var hp_bar_bg: MeshInstance3D
var hp_bar_pivot: Node3D

func _ready() -> void:
	current_health = max_health
	
	# 1. 生成血条
	create_3d_health_bar()
	
	# 2. 连接靶子信号
	if has_node(\"Target3\"):
		if $Target3.has_signal(\"target_hit\"):
			$Target3.target_hit.connect(take_damage)
			print(\"✅ \", name, \" 成功连接到靶子 Target3\")
		else:
			print(\"❌ 错误: Target3 身上没有 target_hit 信号！\")

func take_damage(amount: int) -> void:
	if is_dead: return
	current_health -= amount
	print(\"💥 \", name, \" 受到伤害: \", amount, \" 剩余血量: \", current_health)
	
	update_health_bar() 
	
	if current_health <= 0:
		destroy_base()

func destroy_base() -> void:
	is_dead = true
	current_health = 0
	print(\"💥 \", name, \" 被摧毁！\")
	
	if has_node(\"Target3\"):
		$Target3.deactivate()
		
	# 隐藏血条
	if hp_bar_bg: hp_bar_bg.hide()
	if hp_bar_fill: hp_bar_fill.hide()
		
	base_destroyed.emit(name)

func activate_target() -> void:
	print(name, \" 收到激活指令！\")
	if has_node(\"Target3\"):
		$Target3.activate()

# ================= 3D 血条生成与更新 =================
func create_3d_health_bar() -> void:
	var bar_root = Node3D.new()
	bar_root.position = bar_offset
	add_child(bar_root)
	
	# 1. 背景底板
	hp_bar_bg = MeshInstance3D.new()
	var quad_bg = QuadMesh.new()
	quad_bg.size = Vector2(bar_width, bar_height) 
	hp_bar_bg.mesh = quad_bg
	
	var mat_bg = StandardMaterial3D.new()
	mat_bg.albedo_color = Color(0.1, 0.1, 0.1) # 暗黑色底
	mat_bg.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED 
	mat_bg.billboard_mode = BaseMaterial3D.BILLBOARD_ENABLED # 永远面向镜头
	mat_bg.no_depth_test = true # 穿透地形显示
	hp_bar_bg.material_override = mat_bg
	bar_root.add_child(hp_bar_bg)
	
	# 2. 左锚点 (防偏移核心)
	hp_bar_pivot = Node3D.new()
	hp_bar_pivot.position = Vector3(-bar_width / 2.0, 0, 0) 
	bar_root.add_child(hp_bar_pivot)
	
	# 3. 血条填充
	hp_bar_fill = MeshInstance3D.new()
	var quad_fill = QuadMesh.new()
	quad_fill.size = Vector2(bar_width, bar_height)
	hp_bar_fill.mesh = quad_fill
	
	var mat_fill = StandardMaterial3D.new()
	mat_fill.albedo_color = Color(0.0, 1.0, 0.2) # 绿色
	mat_fill.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat_fill.billboard_mode = BaseMaterial3D.BILLBOARD_ENABLED
	mat_fill.no_depth_test = true
	mat_fill.render_priority = 1 
	hp_bar_fill.material_override = mat_fill
	
	hp_bar_pivot.add_child(hp_bar_fill)
	hp_bar_fill.position.x = bar_width / 2.0 

func update_health_bar() -> void:
	if hp_bar_fill and hp_bar_bg and not is_dead:
		var ratio = float(current_health) / max_health
		ratio = clamp(ratio, 0.0, 1.0)
		
		# 修改宽度和位置，绝对不产生缩放错位
		var mesh = hp_bar_fill.mesh as QuadMesh
		if mesh:
			mesh.size.x = bar_width * ratio
		hp_bar_fill.position.x = (bar_width * ratio) / 2.0
		
		# 变色
		var mat_fill = hp_bar_fill.material_override as StandardMaterial3D
		if mat_fill:
			if ratio > 0.5: 
				mat_fill.albedo_color = Color(0.0, 1.0, 0.2) # 绿
			elif ratio > 0.2: 
				mat_fill.albedo_color = Color(1.0, 1.0, 0.0) # 黄
			else: 
				mat_fill.albedo_color = Color(1.0, 0.0, 0.0) # 红
"

